# Configuración de conexión a PostgreSQL
# Copia este archivo como .env y ajusta los valores a tu entorno.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=demo_web
DB_USER=demo_user
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# Origen del frontend cuando se sirve por separado (por ejemplo, Live Server).
# Si el frontend lo sirve este mismo backend, puedes dejar esta variable vacía.
FRONTEND_URL=
