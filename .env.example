# Configuración de conexión a PostgreSQL
# Copia este archivo como .env y ajusta los valores a tu entorno.

PORT=3000

DB_HOST=localhost
DB_PORT=5432
DB_DATABASE=demo_web
DB_USER=demo_user
DB_PASSWORD=cambia_esta_clave
DB_SSL=false

# Origen adicional permitido por CORS (opcional).
# El backend sirve el frontend en la misma URL, así que normalmente puede quedar vacío.
FRONTEND_URL=
